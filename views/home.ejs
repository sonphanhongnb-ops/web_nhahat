<%- include("partials/head") %>
<%- include("partials/nav") %>

<!-- HERO — cấu hình 3 chế độ nền (Ảnh / Slide / Video) trong Quản trị -->
<%
  var heroMode = settings.hero_mode || 'image';
  var heroSlides = String(settings.hero_slides || '').split(/\r?\n/).map(function(s){ return s.trim(); }).filter(Boolean);
  if (!heroSlides.length) heroSlides = [settings.hero_image || '/img/hero.jpg'];
  var heroInterval = Number(settings.hero_slide_interval || 5);
%>
<main id="top">
<section class="hero hero-<%= heroMode %>">
  <div class="hero-media" aria-hidden="true">
    <% if (heroMode === 'video' && settings.hero_video_url) { %>
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="<%= settings.hero_video_poster || settings.hero_image || '/img/hero.jpg' %>">
        <source src="<%= settings.hero_video_url %>" type="video/mp4">
      </video>
    <% } else if (heroMode === 'slideshow') { %>
      <div class="hero-slides" data-interval="<%= heroInterval %>">
        <% heroSlides.forEach(function(src, i){ %>
          <div class="hero-slide<%= i === 0 ? ' on' : '' %>" style="background-image:url('<%= src %>')"></div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="hero-photo" style="background-image:url('<%= settings.hero_image || '/img/hero.jpg' %>')"></div>
    <% } %>
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <span class="hero-kicker reveal"><%= t('MỘT TRẢI NGHIỆM VĂN HÓA ĐẶC SẮC', 'A CULTURAL SOUND EXPERIENCE') %></span>
    <h1 class="hero-wordmark reveal">THỨC <span class="by">by SEASOUND</span></h1>
    <p class="hero-motto reveal"><%= t('Lắng nghe. Nhận ra.', 'Listen. Realize.') %></p>
    <span class="hero-line reveal" aria-hidden="true"></span>
    <p class="hero-facts reveal">
      <span><%= t('Thứ 4 đến Chủ nhật', 'Wednesday to Sunday') %> · 7:30 PM – 8:30 PM</span>
      <span>Alluvium · Hoa Lư · Ninh Bình<%= lang === 'en' ? ', Vietnam' : '' %></span>
    </p>
    <a class="btn btn-gold hero-book reveal" href="#lich-dien"><%= t('Đặt vé ngay', 'Book your seats') %></a>
  </div>

  <a class="scrollcue" href="#gioi-thieu" aria-label="<%= t('Cuộn xuống', 'Scroll') %>"><span class="dot"></span></a>
</section>

<!-- SECTION 2 — LỊCH DIỄN & GIÁ VÉ (thông tin cốt lõi, ngay sau Hero) -->
<section class="band ticketing" id="lich-gia">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow"><%= t('Lịch diễn & Giá vé', 'Schedule & Tickets') %></span><span class="rule"></span></div>
    <div class="tk-grid">
      <div class="tk-sched reveal">
        <h3 class="tk-label"><%= t('Lịch biểu diễn', 'Performance schedule') %></h3>
        <p class="tk-days"><%= t('Từ Thứ 4 đến Chủ nhật', 'Wednesday to Sunday') %></p>
        <p class="tk-time">7:30 PM – 8:30 PM</p>
        <p class="tk-sub"><%= t('60 phút · không giải lao', '60 minutes · no intermission') %></p>
      </div>
      <div class="tk-price reveal">
        <h3 class="tk-label"><%= t('Bảng giá', 'Ticket prices') %></h3>
        <div class="price-wrap">
          <table class="price-table">
            <thead><tr>
              <th><%= t('Hạng vé', 'Tier') %></th>
              <th><%= t('Giá (VNĐ)', 'Price (VND)') %></th>
              <th><%= t('USD (tham khảo)', 'USD (approx.)') %></th>
            </tr></thead>
            <tbody>
              <tr><td>ECO</td><td>450.000&nbsp;đ</td><td>~18 USD</td></tr>
              <tr><td>VIP</td><td>600.000&nbsp;đ</td><td>~24 USD</td></tr>
              <tr><td>VVIP</td><td>750.000&nbsp;đ</td><td>~30 USD</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <p class="tk-note reveal"><%= t('Vé bao gồm toàn bộ buổi diễn 60 phút. Vui lòng đến trước 15 phút.', 'Ticket includes the full 60-minute performance. Please arrive 15 minutes early.') %></p>
    <div class="tk-cta reveal">
      <a class="btn btn-gold" href="#lich-dien"><%= t('Chọn ngày & đặt vé', 'Select date & book') %></a>
    </div>
  </div>
</section>

<!-- VỀ THỨC — slider 2 trang (giới thiệu / bài thơ) + 3 điểm nhấn -->
<%
  // Trang 1 — giới thiệu
  var vtIntro = lang === 'en' ? {
    lead: 'THỨC is the debut performance of the Southeast Asian Indigenous Orchestra — SEASOUND.',
    body: 'Rooted in the indigenous music of Southeast Asia, THỨC offers a singular contemporary music experience — a language and aesthetic entirely its own.',
    strong: ['Sixty minutes. Six original compositions.', 'No folk arrangements. No Western orchestration. No words.']
  } : {
    lead: 'THỨC là vở diễn đầu tiên của Dàn Khí Nhạc Bản Địa Đông Nam Á — SEASOUND.',
    body: 'Được xây dựng trên nền tảng âm nhạc bản địa Đông Nam Á, THỨC hứa hẹn mang đến trải nghiệm âm nhạc đương đại độc đáo với ngôn ngữ và phong cách hoàn toàn mới.',
    strong: ['Sáu mươi phút. Sáu tác phẩm sáng tác riêng.', 'Không hòa tấu dân ca. Không hòa âm phối khí. Không lời!']
  };
  // Trang 2 — bài thơ
  var poem = lang === 'en' ? [
    ['Within each of us runs a quiet current —',
     'a place where cultural memory is held:',
     'the lullabies of early childhood,',
     'the folk melodies passed down through generations,',
     'the living sounds of nature,',
     'of everyday life,',
     'of festivals and celebrations…'],
    ['A deep sense of origin. Of belonging.'],
    ['But as life grows more modern,',
     'as cultures blend and accelerate,',
     'that current grows faint.',
     'We grow accustomed to technology,',
     'to standardised emotions and standardised rhythms.',
     'What was once close',
     'becomes distant. Broken.'],
    ['THỨC was created to stir that current again —',
     'the melodies that had fallen silent,',
     'the memories once familiar,',
     'the honest vibrations.'],
    ['Through the pure, unadorned sound —',
     'at times strange, at times startling —',
     'of instruments handcrafted from bamboo, rattan, bronze…',
     'the listener is drawn into a place of quiet depth.',
     'Into resonance with the past, with nature,',
     'with other people, with community,',
     'with a way of life that is unhurried and humane.'],
    ['To listen —', 'and recognise oneself.']
  ] : [
    ['Trong mỗi người luôn tồn tại một dòng chảy âm thầm,',
     'nơi lưu giữ những lớp ký ức văn hóa —',
     'từ những lời mẹ ru êm khi thơ bé,',
     'những làn điệu dân ca,',
     'hay những âm thanh sống động',
     'trong tự nhiên, trong đời sống thường ngày, trong các lễ hội…',
     'Đó là lớp cảm thức sâu xa về nguồn gốc và bản sắc.'],
    ['Nhưng theo thời gian, khi cuộc sống ngày càng hiện đại,',
     'sự giao thoa giữa nhiều nền văn hóa khiến dòng chảy ấy dần mờ nhạt.',
     'Ta quen với công nghệ,',
     'quen tiêu chuẩn hóa cảm xúc và nhịp sống.',
     'Những gì từng rất gần gũi',
     'trở nên xa lạ, đứt đoạn.'],
    ['THỨC được tạo ra để khơi lại dòng chảy ấy —',
     'những giai điệu từng nằm im,',
     'những ký ức quen thuộc,',
     'những rung động thật thà.'],
    ['Qua âm thanh tinh khiết, mộc mạc — đôi khi kỳ dị, lạ tai —',
     'của những nhạc cụ làm thủ công từ tre, nứa, đồng thau…',
     'người nghe được kết nối với một không gian cảm xúc sâu lắng,',
     'được đồng điệu với quá khứ, với thiên nhiên, với con người, với cộng đồng,',
     'với nhịp sống nguyên bản và nhân hậu.'],
    ['Để lắng nghe —', 'và nhận ra chính mình.']
  ];
  // 3 điểm nhấn (icon + text)
  var vtHi = lang === 'en' ? [
    ['leaf',  'Listen to dozens of handcrafted indigenous instruments sounding together in a way that has never existed before.'],
    ['note',  'An intimate, professional listening space with exceptional acoustic quality.'],
    ['spark', 'Found nowhere else.']
  ] : [
    ['leaf',  'Lắng nghe hàng chục nhạc cụ thủ công bản địa cùng hòa âm một cách chưa từng có trước đây.'],
    ['note',  'Không gian nghe nhạc chuyên nghiệp với chất lượng âm thanh vượt trội.'],
    ['spark', 'Không có ở bất kỳ nơi nào khác.']
  ];
  function vtIcon(k){
    if (k === 'leaf')  return '<path d="M5 20c0-9 7-15 15-15 0 9-7 15-15 15z"/><path d="M5 20C9 15 13 12 18 10"/>';
    if (k === 'note')  return '<path d="M9 18V6l10-2v10"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>';
    return '<path d="M12 2c.6 5 3.4 7.8 8.4 8.4-5 .6-7.8 3.4-8.4 8.4-.6-5-3.4-7.8-8.4-8.4C8.6 9.8 11.4 7 12 2z"/>';
  }
  var poemBody = poem.slice(0, poem.length - 1);
  var poemEnd  = poem[poem.length - 1];   // câu kết
%>
<section class="vethuc-x" id="gioi-thieu">

  <!-- 1 · KHÚC MỞ — ảnh nền chuyển động nhẹ + tuyên ngôn -->
  <div class="vx-overture">
    <div class="vx-bg" aria-hidden="true"><img src="/img/vethuc-overture.jpg" alt="" loading="lazy"></div>
    <div class="vx-veil" aria-hidden="true"></div>
    <div class="wrap vx-overture-in">
      <div class="vx-ov-copy">
        <span class="eyebrow reveal"><%= t('Về THỨC', 'About THỨC') %></span>
        <p class="vx-lead reveal"><%= vtIntro.lead %></p>
        <p class="vx-sub reveal"><%= vtIntro.body %></p>
        <div class="vx-tenets reveal">
          <div class="vx-tenet"><b>60</b><span><%= t('phút', 'minutes') %></span></div>
          <div class="vx-tenet"><b>6</b><span><%= t('tác phẩm nguyên bản', 'original works') %></span></div>
        </div>
        <p class="vx-neg reveal"><%= t('Không hòa tấu dân ca. Không hòa âm phối khí.', 'No folk arrangements. No Western orchestration.') %></p>
      </div>
    </div>
    <a class="vx-cue" href="#vx-river" aria-label="<%= t('Đọc tiếp', 'Read on') %>"><span></span></a>
  </div>

  <!-- 2 · DÒNG CHẢY — bài thơ chảy dọc theo đường vàng, tự đầy khi cuộn -->
  <div class="vx-river-wrap" id="vx-river">
    <div class="vx-glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="vx-poem" data-current>
        <div class="vx-line" aria-hidden="true"><span class="vx-fill"></span></div>
        <div class="vx-stanzas">
          <% poemBody.forEach(function(stanza, si){ %>
            <p class="vx-stanza reveal<%= si === 0 ? ' vx-first' : '' %>"><% stanza.forEach(function(line, i){ %><%= line %><% if (i < stanza.length - 1) { %><br><% } %><% }) %></p>
          <% }) %>
        </div>
      </div>
      <blockquote class="vx-close reveal"><% poemEnd.forEach(function(line, i){ %><%= line %><% if (i < poemEnd.length - 1) { %><br><% } %><% }) %></blockquote>
    </div>
  </div>

  <!-- 3 · ĐIỂM NHẤN — vì sao nên đến -->
  <div class="wrap">
    <div class="vx-highlights">
      <% vtHi.forEach(function(h){ %>
        <div class="vx-hl reveal">
          <span class="vt-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- vtIcon(h[0]) %></svg></span>
          <p><%= h[1] %></p>
        </div>
      <% }) %>
    </div>
  </div>

</section>

<!-- SECTION 4 — SOCIAL PROOF (cảm nhận / ghi nhận)
     GHI CHÚ: Sau đêm ra mắt 2/9, thêm quote khán giả THẬT vào mảng audienceQuotes bên dưới
     (giữ nguyên văn, không chỉnh sửa) — section sẽ tự chuyển sang hiển thị quote khán giả.
     Trước 2/9: mảng để trống → hiển thị chứng thực Seaphony 2017. -->
<%
  var audienceQuotes = [
    // { text: 'I didn\'t understand a word. I didn\'t need to.', by: 'Sarah M.', place: 'Australia' },
    // { text: 'Tôi không hiểu tại sao tôi khóc. Nhưng tôi khóc.', by: 'Nguyễn H.', place: 'Hà Nội' },
  ];
%>
<section class="band proof" id="cam-nhan">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow"><%= t('Cảm nhận', 'Voices') %></span><span class="rule"></span></div>

    <% if (audienceQuotes.length) { %>
      <!-- Sau 2/9 — quote khán giả thật -->
      <div class="proof-grid">
        <% audienceQuotes.forEach(function(qq){ %>
          <figure class="proof-card reveal">
            <blockquote><%= '“' + qq.text + '”' %></blockquote>
            <p class="proof-by">— <b><%= qq.by %></b><%= qq.place ? ', ' + qq.place : '' %></p>
          </figure>
        <% }) %>
      </div>
      <p class="proof-cred reveal"><%= t('Cùng ê-kíp đứng sau', 'From the team behind') %>
        <b>Seaphony 2017</b> · <%= t('Nhà hát Lớn Hà Nội', 'Hanoi Opera House') %>
        · 50+ <%= t('nghệ nhân', 'artists') %> · 500+ <%= t('khán giả', 'audience') %></p>
    <% } else { %>
      <!-- Trước 2/9 — chứng thực Seaphony 2017 -->
      <figure class="proof-quote reveal">
        <blockquote><%= t('Đây là cột mốc lịch sử của âm nhạc thể nghiệm Việt Nam.', 'A historic milestone for experimental music in Vietnam.') %></blockquote>
        <figcaption>— <b><%= t('Nhà hát Lớn Hà Nội', 'Hanoi Opera House') %></b> · <%= t('Tháng 12, 2017', 'December 2017') %></figcaption>
      </figure>
      <div class="proof-stats">
        <div class="proof-stat reveal"><b>50+</b><span><%= t('nghệ nhân', 'artists') %></span></div>
        <div class="proof-stat reveal"><b>500+</b><span><%= t('khán giả', 'audience members') %></span></div>
      </div>
    <% } %>
  </div>
</section>

<!-- SECTION 5 — DỰ ÁN SEASOUND (teaser gọn, dẫn sang trang /seasound; không mở rộng trên homepage) -->
<section class="band sea-teaser" id="du-an">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow"><%= t('Dự án · Nghệ sĩ · Nhạc cụ', 'The project') %></span><span class="rule"></span></div>
    <div class="st-grid">
      <div class="st-lead reveal">
        <h2 class="st-title">SEASOUND<span><%= t('Dàn Khí Nhạc Bản Địa Đông Nam Á', 'Southeast Asian Indigenous Orchestra') %></span></h2>
        <p><%= t(
          'Dự án nghiên cứu & thực hành âm nhạc dài hạn — xây dựng đại dàn nhạc đầu tiên lấy nhạc khí bản địa Đông Nam Á làm trung tâm. THỨC là vở diễn đầu tiên bước ra từ dự án này.',
          'A long-term music research & practice project — building the first orchestra centered on the indigenous instruments of Southeast Asia. THỨC is its first performance.') %></p>
        <a class="btn btn-gold st-btn" href="/seasound"><%= t('Tìm hiểu thêm về SEASOUND', 'Learn more about SEASOUND') %> →</a>
      </div>
      <ol class="st-time reveal">
        <li><b>2006</b><span><%= t('Khởi xướng', 'Initiated') %></span></li>
        <li><b>2016</b><span><%= t('Định hình dự án', 'Formalized') %></span></li>
        <li><b>2017</b><span><%= t('Seaphony · Hà Nội', 'Seaphony · Hanoi') %></span></li>
        <li><b>9/2025</b><span><%= t('SEASOUND · Ninh Bình', 'SEASOUND · Ninh Bình') %></span></li>
        <li class="on"><b><%= t('Nay', 'Now') %></b><span><%= t('Năm 1 · lộ trình 5 năm', 'Year 1 of 5') %></span></li>
      </ol>
    </div>
  </div>
</section>

<!-- SPACE -->
<section class="band space" id="khong-gian">
  <svg class="vault" aria-hidden="true" viewBox="0 0 1200 400" preserveAspectRatio="none"><g id="vaultg"></g></svg>
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow"><%= t('Không gian', 'Venue') %></span><span class="rule"></span></div>
    <div class="grid">
      <div class="reveal">
        <h2><%= t('Trung tâm Biểu diễn', 'Alluvium Performing') %> <em><%= t('Alluvium', 'Arts Center') %></em>.</h2>
        <p><%= t(
          'THỨC được trình diễn tại Trung tâm Biểu diễn Alluvium, trên đường Đinh Tiên Hoàng, Hoa Lư, Ninh Bình — trong vùng quần thể danh thắng Tràng An. Một không gian dựng riêng cho âm thanh bản địa, để tre, đồng và da vang lên đúng như nó vốn có.',
          'THỨC is performed at the Alluvium Performing Arts Center on Dinh Tien Hoang Street, Hoa Lu, Ninh Binh — within the Trang An landscape complex. A space built for indigenous sound, where bamboo, bronze and leather resonate exactly as they should.') %></p>
        <div class="stats">
          <div><b>60′</b><span><%= t('Thời lượng', 'Duration') %></span></div>
          <div><b>2</b><span><%= t('Suất mỗi ngày', 'Shows per day') %></span></div>
          <div><b>5</b><span><%= t('Ngày mỗi tuần', 'Days per week') %></span></div>
          <div><b>200</b><span><%= t('Ghế', 'Seats') %></span></div>
        </div>
      </div>
      <div class="space-media reveal">
        <img class="full" src="/img/space-1.jpg" alt="<%= t('Không gian biểu diễn Alluvium', 'Alluvium performance space') %>" loading="lazy">
        <img class="half" src="/img/space-2.jpg" alt="<%= t('Sân khấu nhìn từ khán đài Alluvium', 'Stage seen from the Alluvium auditorium') %>" loading="lazy">
        <img class="half" src="/img/space-3.jpg" alt="<%= t('Chi tiết không gian biểu diễn Alluvium', 'Detail of the Alluvium performance space') %>" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- PROGRAM -->
<section class="band program" id="lich-dien">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow"><%= t('Đặt vé', 'Booking') %></span><span class="rule"></span></div>
    <h2 class="reveal"><%= t('Suất diễn sắp tới', 'Upcoming performances') %></h2>
    <div class="shows">
<% shows.forEach(function(s){ %>
      <a class="show reveal" href="<%= s.url %>" data-show-id="<%= s.id %>">
        <span class="date"><span class="d"><%= s.day %></span><span class="m"><%= s.monthLabel %></span></span>
        <span class="title"><%= s.title %><small><%= s.subtitle %> · <%= s.time %></small></span>
        <span class="tag"<%= s.on_sale ? '' : ' style="color:var(--gold);border-color:var(--line)"' %>><%= s.on_sale ? t('Còn vé', 'On sale') : t('Sắp mở bán', 'Coming soon') %></span>
        <span class="book"><%= s.on_sale ? t('Đặt vé →', 'Reserve →') : t('Nhắc tôi →', 'Notify me →') %></span>
      </a>
<% }) %>
<% if(!shows.length){ %><p class="hint"><%= t('Lịch diễn đang được cập nhật.', 'Schedule is being updated.') %></p><% } %>
    </div>
    <p class="hint reveal" style="margin-top:1.6rem"><%= t(
      'Biểu diễn Thứ Tư – Chủ Nhật · hai suất mỗi ngày 15:00 và 18:00 · mỗi suất 60 phút, không giải lao.',
      'Performances Wednesday – Sunday · two shows daily at 3:00 PM and 6:00 PM · each 60 minutes, no intermission.') %></p>
    <p class="hint reveal" style="margin-top:.4rem"><%= t('Giá vé:', 'Tickets:') %> <b style="color:var(--gold)"><%= t('ECO 450.000đ', 'ECO VND 450,000') %></b> · <b style="color:var(--gold)"><%= t('VIP 600.000đ', 'VIP VND 600,000') %></b> · <b style="color:var(--gold)"><%= t('VVIP 750.000đ', 'VVIP VND 750,000') %></b> · <%= t('Trẻ dưới 6 tuổi miễn phí · Trẻ dưới 3 tuổi không vào khán phòng.', 'Children under 6 free · Children under 3 not admitted.') %></p>
  </div>
</section>

<!-- VISIT -->
<section class="band visit" id="ghe-tham">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow"><%= t('Ghé thăm', 'Visit') %></span><span class="rule"></span></div>
    <div class="grid">
      <div class="reveal">
        <h2><%= t('Giữa', 'In the heart of') %> <em><%= t('lòng di sản', 'Trang An') %></em> <%= t('Tràng An.', 'heritage.') %></h2>
        <div class="info" style="margin-top:1.8rem">
          <dl>
