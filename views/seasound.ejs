<%- include("partials/head", { extraCss: '/css/pages.css' }) %>
<%- include("partials/nav") %>

<main id="top" class="page-main sea-page">

  <!-- Tiêu đề -->
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><%= t('Dự án', 'The project') %></span>
      <h1>SEASOUND</h1>
      <p class="lede"><%= t('Dàn Khí Nhạc Bản Địa Đông Nam Á', 'Southeast Asian Indigenous Orchestra') %></p>
    </div>
  </section>

  <!-- Giới thiệu dự án -->
  <section class="band sea-intro">
    <div class="wrap">
      <div class="sea-copy">
        <p><%= t(
          'SEASOUND là dự án nghiên cứu và thực hành âm nhạc dài hạn nhằm xây dựng mô hình đại dàn nhạc đầu tiên lấy các nhạc khí bản địa Đông Nam Á làm trung tâm — không mô phỏng hình thức tổ chức dàn nhạc giao hưởng phương Tây, không phục dựng âm nhạc truyền thống theo kiểu bảo tàng hóa, mà xây dựng một ngôn ngữ khí nhạc mới xuất phát từ logic âm thanh đặc thù và tri thức nội tại của các nhạc khí bản địa khu vực.',
          'SEASOUND is a long-term research and practice project — building the first orchestral model centered on the indigenous instruments of Southeast Asia. Not modeled on the Western symphony orchestra. Not a museum reconstruction of traditional music. But the development of a new instrumental language, one that emerges from the distinctive sonic logic and internal knowledge of the region’s indigenous instruments.') %></p>
        <p><%= t(
          'Được khởi xướng bởi nhạc sĩ Nguyễn Nhất Lý từ năm 2006, được định hình thành dự án vào năm 2016, thử nghiệm lần đầu tại Hà Nội năm 2017 dưới tên Seaphony, và được tái khởi động với đầu tư chính thức từ tháng 9/2025 tại Ninh Bình bởi Alluvium Production dưới tên SEASOUND — dự án hiện đang trong năm thứ nhất của lộ trình thực hiện 5 năm.',
          'Initiated by composer Nguyễn Nhất Lý in 2006, formalized as a project in 2016, and first performed in Hanoi in 2017 under the name Seaphony. SEASOUND was relaunched with formal investment in September 2025 in Ninh Bình by Alluvium Production. The project is currently in its first year of a five-year roadmap.') %></p>
      </div>

      <!-- Dòng thời gian -->
      <ol class="sea-timeline">
        <li><span class="yr">2006</span><span class="ev"><%= t('Nhạc sĩ Nguyễn Nhất Lý khởi xướng', 'Initiated by composer Nguyễn Nhất Lý') %></span></li>
        <li><span class="yr">2016</span><span class="ev"><%= t('Định hình thành dự án', 'Formalized as a project') %></span></li>
        <li><span class="yr">2017</span><span class="ev"><%= t('Thử nghiệm đầu tiên tại Hà Nội — Seaphony', 'First performed in Hanoi — Seaphony') %></span></li>
        <li><span class="yr">9 / 2025</span><span class="ev"><%= t('Tái khởi động tại Ninh Bình — SEASOUND (Alluvium Production)', 'Relaunched in Ninh Bình — SEASOUND (Alluvium Production)') %></span></li>
        <li class="on"><span class="yr"><%= t('Nay', 'Now') %></span><span class="ev"><%= t('Năm thứ nhất của lộ trình 5 năm', 'Year one of a five-year roadmap') %></span></li>
      </ol>
    </div>
  </section>

  <!-- Nghệ sĩ -->
  <section class="band sea-block artists">
    <div class="wrap">
      <div class="sea-head"><span class="eyebrow"><%= t('Nghệ sĩ', 'The artists') %></span><span class="rule"></span></div>
      <p class="sea-lead"><%= t(
        'Dưới sự dẫn dắt của nhạc sĩ — giám đốc nghệ thuật Nguyễn Nhất Lý, dàn nhạc quy tụ các nghệ nhân chơi trực tiếp nhạc khí bản địa.',
        'Led by composer and artistic director Nguyễn Nhất Lý, the ensemble brings together artists performing the indigenous instruments live.') %></p>
      <div class="people">
        <div class="person reveal">
          <div class="por"><span class="mono">NL</span><span class="tagcap"><%= t('Ảnh chân dung · 3:4', 'Portrait · 3:4') %></span></div>
          <h3>Nguyễn Nhất Lý</h3><div class="role"><%= t('Nhạc sĩ · Giám đốc nghệ thuật', 'Composer · Artistic Director') %></div>
          <p><%= t('Người khởi xướng SEASOUND và dàn dựng vở diễn đầu tiên — THỨC.', 'Founder of SEASOUND and creator of its debut work — THỨC.') %></p>
        </div>
        <div class="person reveal">
          <div class="por"><span class="mono">AP</span><span class="tagcap"><%= t('Ảnh · 3:4', 'Photo · 3:4') %></span></div>
          <h3>Alluvium Production</h3><div class="role"><%= t('Nhà đầu tư & sản xuất', 'Investor & Producer') %></div>
          <p><%= t('Đơn vị đầu tư cho SEASOUND và không gian biểu diễn Alluvium tại Hoa Lư.', 'Backer of SEASOUND and of the Alluvium performance space in Hoa Lư.') %></p>
        </div>
        <div class="person reveal">
          <div class="por"><span class="mono">SS</span><span class="tagcap"><%= t('Ảnh · 3:4', 'Photo · 3:4') %></span></div>
          <h3><%= t('Dàn nhạc SEASOUND', 'The SEASOUND Ensemble') %></h3><div class="role"><%= t('Nghệ nhân & nhạc công', 'Artists & musicians') %></div>
          <p><%= t('Những người còn nhớ cách lắng nghe — tấu lên trên nhạc cụ tre, nứa, đồng, da.', 'Those who still know how to listen — playing instruments of bamboo, reed, bronze and leather.') %></p>
        </div>
        <div class="person reveal">
          <div class="por"><span class="mono">TH</span><span class="tagcap"><%= t('Ảnh · 3:4', 'Photo · 3:4') %></span></div>
          <h3>THỨC</h3><div class="role"><%= t('Vở diễn đầu tiên', 'The debut work') %></div>
          <p><%= t('Tiếng nói đầu tiên của SEASOUND — không mô phỏng phương Tây, không bảo tàng hoá truyền thống.', 'SEASOUND’s first voice — not modelled on Western forms, not museum pieces.') %></p>
        </div>
      </div>
      <p class="sea-note"><%= t('Hồ sơ từng nghệ sĩ (tên · vai trò · nhạc cụ) đang được cập nhật.', 'Individual profiles (name · role · instrument) are being updated.') %></p>
    </div>
  </section>

  <!-- Nhạc cụ · Chất liệu (4 chất liệu) -->
  <section class="band sea-block instruments">
    <div class="wrap">
      <div class="sea-head"><span class="eyebrow"><%= t('Nhạc cụ', 'The instruments') %></span><span class="rule"></span></div>
      <p class="sea-lead"><%= t(
        'Tre, nứa, đồng thau, da — bốn chất liệu bản địa được chế tác thủ công, mỗi cây một tiếng nói riêng.',
        'Bamboo, reed, bronze, leather — four indigenous materials, handcrafted, each with a voice of its own.') %></p>
      <div class="cards">
        <div class="card reveal">
          <svg class="glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M10 6v28M18 6v28M26 6v28M34 6v28"/></svg>
          <span class="idx"><%= t('tre', 'bamboo') %></span>
          <h3><%= t('Tre', 'Bamboo') %></h3>
          <p><%= t('Ống tre cho âm thanh trong và ấm — nền của nhiều tác phẩm trong vở diễn.', 'Bamboo pipes give a clear, warm tone — the foundation of many works in the performance.') %></p>
        </div>
        <div class="card reveal">
          <svg class="glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 20h32M8 20v-4M14 20v-4M20 20v-4M26 20v-4M32 20v-4"/></svg>
          <span class="idx"><%= t('nứa', 'reed') %></span>
          <h3><%= t('Nứa', 'Reed') %></h3>
          <p><%= t('Nứa mảnh cho những âm sắc ban sơ, mở ra khoảng lặng đầu tiên của đêm diễn.', 'Slender reed gives the first, primal timbres — opening the earliest silence of the night.') %></p>
        </div>
        <div class="card reveal">
          <svg class="glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="20" cy="20" r="14"/><circle cx="20" cy="20" r="5"/></svg>
          <span class="idx"><%= t('đồng', 'bronze') %></span>
          <h3><%= t('Đồng', 'Bronze') %></h3>
          <p><%= t('Cồng, chiêng và nhạc cụ đồng mang âm trầm ngân dài, giữ nhịp cho cả dàn nhạc.', 'Gongs and bronze instruments carry a deep, lingering resonance, keeping time for the whole ensemble.') %></p>
        </div>
        <div class="card reveal">
          <svg class="glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="20" cy="20" r="14"/><path d="M6 20h28"/></svg>
          <span class="idx"><%= t('da', 'leather') %></span>
          <h3><%= t('Da', 'Leather') %></h3>
          <p><%= t('Trống da tạo nên nhịp đập — nhịp trống trong một buổi lễ đã lâu, trở về trong THỨC.', 'Leather drums form the heartbeat — the drum of a long-past ceremony, returning in THỨC.') %></p>
        </div>
      </div>
      <p class="sea-note"><%= t('Bộ ảnh chất liệu (cận cảnh) đang được cập nhật.', 'Close-up material photography is being updated.') %></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="band sea-cta">
    <div class="wrap">
      <p class="sea-cta-line"><%= t('THỨC là vở diễn đầu tiên bước ra từ dự án SEASOUND.', 'THỨC is the first performance to emerge from the SEASOUND project.') %></p>
      <div class="sea-cta-btns">
        <a class="btn btn-gold" href="<%= (typeof isHome !== 'undefined' && isHome) ? '' : '/' %>#lich-dien"><%= t('Đặt vé xem THỨC', 'Book THỨC') %></a>
        <a class="btn btn-ghost" href="/"><%= t('← Về trang chủ', '← Back home') %></a>
      </div>
    </div>
  </section>

</main>

<%- include("partials/footer") %>
<%- include("partials/end") %>
