<!-- BOOKING MODAL -->
<div class="modal" id="booking" role="dialog" aria-modal="true" aria-labelledby="bk-title" aria-hidden="true">
  <div class="modal-overlay" data-close></div>
  <div class="modal-panel">
    <div class="modal-head">
      <span class="t" id="bk-title"><%= t('Đặt vé', 'Reserve seats') %></span>
      <button class="modal-close" data-close aria-label="<%= t('Đóng', 'Close') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="steps" id="bk-steps"></div>
    <div class="modal-body" id="bk-body"></div>
    <div class="modal-foot" id="bk-foot"></div>
  </div>
</div>



<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lbx" aria-label="Đóng"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  <img alt="" referrerpolicy="no-referrer">
</div>
