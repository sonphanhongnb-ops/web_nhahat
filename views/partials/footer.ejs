<!-- FOOTER -->
<% var fhome = (typeof isHome !== 'undefined' && isHome) ? '' : '/'; %>
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="brand"><b>THỨC</b><span>by SEASOUND</span></div>
        <p><%= lang === 'en' && settings.site_description_en ? settings.site_description_en : settings.site_description %></p>
        <form class="foot-sub" id="foot-sub" novalidate>
          <label for="foot-sub-email"><%= t('Nhận bản tin đêm diễn', 'Subscribe to our newsletter') %></label>
          <div class="inline">
            <input id="foot-sub-email" type="email" name="email" placeholder="<%= t('Email của bạn', 'Your email') %>" autocomplete="email" required>
            <button class="btn btn-gold btn-sm" type="submit"><%= t('Đăng ký', 'Subscribe') %></button>
          </div>
          <div class="msg" id="foot-sub-msg" role="status" aria-live="polite"></div>
        </form>
      </div>
      <div class="foot-col">
        <h4><%= t('Khám phá', 'Explore') %></h4>
        <a href="<%= fhome %>#gioi-thieu"><%= t('Về THỨC', 'About THỨC') %></a>
        <a href="<%= fhome %>#khong-gian"><%= t('Không gian', 'Venue') %></a>
        <a href="/seasound">SEASOUND</a>
      </div>
      <div class="foot-col">
        <h4><%= t('Đến với chúng tôi', 'Come to us') %></h4>
        <a href="<%= fhome %>#lich-dien"><%= t('Lịch diễn & Đặt vé', 'Schedule & Reserve') %></a>
        <a href="<%= fhome %>#ghe-tham"><%= t('Ghé thăm', 'Visit') %></a>
        <a href="/trang/lien-he-thuc-by-seasound"><%= t('Liên hệ', 'Contact') %></a>
        <a href="/tin-tuc"><%= t('Tin tức', 'News') %></a>
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="foot-col foot-contact">
        <h4><%= t('Liên hệ', 'Contact') %></h4>
        <a href="mailto:tickets@seasound.com">tickets@seasound.com</a>
        <a href="https://www.facebook.com/thuc.seasound" target="_blank" rel="noopener">Facebook: @thuc.seasound</a>
        <a href="https://www.instagram.com/thuc.seasound" target="_blank" rel="noopener">Instagram: @thuc.seasound</a>
        <span class="foot-div" aria-hidden="true"></span>
        <span class="foot-label"><%= t('Dành cho khách sạn & đối tác:', 'For hotels & partners:') %></span>
        <a href="mailto:partner@seasound.com">partner@seasound.com</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© <%= new Date().getFullYear() %> SEASOUND · <%= settings.organization_address %></span>
      <span>
        <% if (user) { %>
          <a href="/admin"><%= t('Bảng quản trị', 'Admin') %></a> ·
          <a href="/dang-xuat"><%= t('Đăng xuất', 'Log out') %></a>
        <% } else { %>
          <a href="/dang-nhap" rel="nofollow"><%= t('Đăng nhập', 'Log in') %></a>
        <% } %>
      </span>
    </div>
  </div>
</footer>
