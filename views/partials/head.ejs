<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'vi' %>">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- ================= SEO CƠ BẢN ================= -->
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>" />
<% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>" /><% } %>
<meta name="robots" content="<%= seo.robots %>" />
<meta name="googlebot" content="<%= seo.robots %>" />
<link rel="canonical" href="<%= seo.canonical %>" />
<% if (seo.prev) { %><link rel="prev" href="<%= seo.prev %>" /><% } %>
<% if (seo.next) { %><link rel="next" href="<%= seo.next %>" /><% } %>
<meta name="author" content="<%= seo.author || seo.siteName %>" />
<meta name="theme-color" content="#14100a" />
<% var _sep = seo.canonical.indexOf('?') >= 0 ? '&' : '?'; %>
<link rel="alternate" hreflang="vi" href="<%= seo.canonical %><%= _sep %>lang=vi" />
<link rel="alternate" hreflang="en" href="<%= seo.canonical %><%= _sep %>lang=en" />
<link rel="alternate" hreflang="x-default" href="<%= seo.canonical %>" />

<!-- ================= OPEN GRAPH ================= -->
<meta property="og:site_name" content="<%= seo.siteName %>" />
<meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'vi_VN' %>" />
<meta property="og:locale:alternate" content="<%= lang === 'en' ? 'vi_VN' : 'en_US' %>" />
<meta property="og:type" content="<%= seo.type %>" />
<meta property="og:title" content="<%= seo.rawTitle %>" />
<meta property="og:description" content="<%= seo.description %>" />
<meta property="og:url" content="<%= seo.url %>" />
<meta property="og:image" content="<%= seo.image %>" />
<meta property="og:image:alt" content="<%= seo.imageAlt %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<% if (seo.publishedTime) { %><meta property="article:published_time" content="<%= seo.publishedTime %>" /><% } %>
<% if (seo.modifiedTime) { %><meta property="article:modified_time" content="<%= seo.modifiedTime %>" /><% } %>
<% if (seo.author) { %><meta property="article:author" content="<%= seo.author %>" /><% } %>
<% if (seo.section) { %><meta property="article:section" content="<%= seo.section %>" /><% } %>
<% (seo.tags || []).forEach(function(t){ %><meta property="article:tag" content="<%= t %>" />
<% }) %>

<!-- ================= TWITTER CARD ================= -->
<meta name="twitter:card" content="<%= seo.twitterCard %>" />
<meta name="twitter:title" content="<%= seo.rawTitle %>" />
<meta name="twitter:description" content="<%= seo.description %>" />
<meta name="twitter:image" content="<%= seo.image %>" />
<meta name="twitter:image:alt" content="<%= seo.imageAlt %>" />

<!-- ================= XÁC MINH CHỦ SỞ HỮU ================= -->
<% if (seo.verifications.google) { %><meta name="google-site-verification" content="<%= seo.verifications.google %>" /><% } %>
<% if (seo.verifications.bing) { %><meta name="msvalidate.01" content="<%= seo.verifications.bing %>" /><% } %>
<% if (seo.verifications.facebook) { %><meta name="facebook-domain-verification" content="<%= seo.verifications.facebook %>" /><% } %>

<!-- ================= DỮ LIỆU CÓ CẤU TRÚC ================= -->
<% (typeof jsonLd !== 'undefined' ? jsonLd : []).forEach(function(item){ %>
<script type="application/ld+json"><%- JSON.stringify(item) %></script>
<% }) %>

<!-- ================= TÀI NGUYÊN ================= -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap&subset=vietnamese" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v=<%= assetVer %>">
<% if (typeof extraCss !== 'undefined' && extraCss) { %><link rel="stylesheet" href="<%= extraCss %>"><% } %>
<link rel="alternate" type="application/rss+xml" title="<%= seo.siteName %> — Tin tức" href="/rss.xml">
<link rel="manifest" href="/site.webmanifest">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">

<% if (seo.ga) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= seo.ga %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '<%= seo.ga %>');
</script>
<% } %>
</head>
<body>
<div class="grain" aria-hidden="true"></div>
