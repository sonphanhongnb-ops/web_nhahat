# ==========================================================
#  THỨC by SEASOUND — Cấu hình môi trường (sao chép thành .env)
# ==========================================================

# Cổng và địa chỉ máy chủ
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# BẮT BUỘC khi chạy thật: dùng cho canonical URL, sitemap, RSS, Open Graph.
# Khi deploy, đặt = URL thật (vd https://thuc-seasound.onrender.com hoặc tên miền riêng).
SITE_URL=http://localhost:3000

# Ngôn ngữ mặc định khi khách chưa chọn: vi | en
DEFAULT_LANG=vi

# Khoá ký cookie phiên. Để trống thì hệ thống tự sinh; khi deploy NÊN đặt cố định.
# SESSION_SECRET=
SESSION_DAYS=14

# Cơ sở dữ liệu SQLite. Khi deploy, trỏ vào ổ đĩa lưu trữ để không mất dữ liệu.
# DB_FILE=/data/app.db

# Thư mục lưu ảnh tải lên. Khi deploy, trỏ vào ổ đĩa lưu trữ.
# UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=8

# Đặt 1 khi chạy sau proxy (Render/Railway/Nginx/Cloudflare) để lấy đúng IP khách
TRUST_PROXY=0

# Tài khoản quản trị được tạo ở lần khởi động đầu tiên — ĐỔI MẬT KHẨU ngay sau khi đăng nhập
SEED_ADMIN_EMAIL=admin@seasound.com
SEED_ADMIN_PASSWORD=Seasound@2026
